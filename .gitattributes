# Keep source files stable across Windows, macOS, and Linux checkouts.
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.sh text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.aidl text eol=lf
*.mk text eol=lf

# Prebuilt dependencies and application assets are binary.
*.a -text
*.aar -text
*.jar -text
*.png -text
*.webp -text
*.so -text
app/src/root/assets/root-runtime/arm64-v8a/moodtools-injector -text
