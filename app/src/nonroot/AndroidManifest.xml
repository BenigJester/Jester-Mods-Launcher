<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Menus are hosted inside the game process. The removed compatibility-overlay
         experiment must not leak special overlay access in through BlackBox. -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SYSTEM_OVERLAY_WINDOW"
        tools:node="remove" />

    <!-- BlackBox declares a broad compatibility permission set for arbitrary apps. Games
         supported by this launcher do not use telephony, SMS, call logs, or contacts, and
         internet-sideloaded APKs declaring SMS access are blocked by Google Play Protect. -->
    <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.BROADCAST_WAP_PUSH" tools:node="remove" />
    <uses-permission android:name="android.permission.BROADCAST_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.SEND_RESPOND_VIA_MESSAGE" tools:node="remove" />
    <uses-permission android:name="android.provider.Telephony.SMS_RECEIVED" tools:node="remove" />
    <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PRECISE_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.WRITE_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_PHONE_NUMBERS" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_PRECISE_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.FOREGROUND_SERVICE_PHONE_CALL" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.WRITE_CONTACTS" tools:node="remove" />

    <!-- BlackBox is hosted directly by the single non-root launcher package. -->
    <application android:name=".HubApplication">
        <provider
            android:name=".identity.IdentityPayloadProvider"
            android:authorities="${applicationId}.identity-payload"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- Keep the visible launcher in a stable task of its own. BlackBox guest
             activities use separate proxy tasks and must never become the task
             Android restores for the launcher from Recents. -->
        <activity
            android:name=".LauncherActivity"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.launcher"
            tools:replace="android:launchMode" />
        <service
            android:name=".LauncherTaskLifecycleService"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- Facebook's browser callback cannot resolve directly to an activity that exists only
             inside BlackBox. Receive the standard fbconnect Custom Tab callback in the physical
             host, validate its cct.<guest-package> authority, then hand it to the matching live
             virtual Facebook transaction. -->
        <activity
            android:name=".FacebookCallbackActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="fbconnect" />
            </intent-filter>
        </activity>
    </application>
</manifest>
